# ─── Root .gitignore ──────────────────────────────────────────────────────────

# Environment files — NEVER commit secrets
.env
.env.local
.env.production
.env.*.local

# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test outputs
coverage/

# Netlify
.netlify/
